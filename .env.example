# Google Maps Embed API — https://console.cloud.google.com/
# Enable "Maps Embed API" for the project that owns this key.
VITE_GOOGLE_MAPS_API_KEY=

# Contact form POST URL (JSON). Defaults in app code to FormSubmit for
# contacto@grupovantor.com if left empty (no API key required).
# Example FormSubmit: https://formsubmit.co/ajax/contacto@grupovantor.com
# Example Formspree: https://formspree.io/f/xxxxxxxx
# Example Web3Forms: https://api.web3forms.com/submit
#
# FormSubmit one-time setup: after the first submission, open the inbox for
# contacto@grupovantor.com and click the activation link. Later submissions
# are delivered automatically.
VITE_CONTACT_FORM_ENDPOINT=

# Optional alias of VITE_CONTACT_FORM_ENDPOINT (kept for compatibility).
VITE_CONTACT_ENDPOINT=

# Optional Web3Forms public access key (safe for the client). If set and no
# endpoint is provided, the form posts to https://api.web3forms.com/submit.
# Create a key at https://web3forms.com and set the recipient to contacto@grupovantor.com
VITE_WEB3FORMS_ACCESS_KEY=
